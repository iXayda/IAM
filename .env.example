# 复制为仓库根目录的 .env，替换示例地址并填写所需密码。
# Docker Compose 自动读取 .env；宿主机中同名环境变量优先。
# .env 仅用于本地配置，真实凭据不要提交到仓库。

# 镜像与构建方式
# 使用本地派生镜像时，将 IAM_IMAGE 改为对应的镜像名。
IAM_IMAGE=iam:jvm
IAM_DOCKERFILE=build/Dockerfile.jvm
# 启用接口文档时改为 runtime,documentation。
IAM_PROFILES=runtime

# 堆上限使用可用内存的 50%，为非堆开销保留空间；按容器限额调整。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0

# 宿主机监听地址与端口
IAM_BIND_ADDRESS=127.0.0.1
IAM_PORT=8443

# 数据库地址须能从 IAM 容器访问，连接使用受限运行账号。
SPRING_DATASOURCE_URL=jdbc:postgresql://database.example.invalid:5432/iam
SPRING_DATASOURCE_USERNAME=iam_runtime
SPRING_DATASOURCE_PASSWORD=

# 默认由 IAM 提供 HTTPS；/run/iam/tls.p12 及保护密钥须允许 UID 10001 读取。
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE_PASSWORD=

# 外部代理终止 TLS、通过受保护内网 HTTP 回源时：
# SERVER_SSL_ENABLED=false，SERVER_FORWARD_HEADERS_STRATEGY=NATIVE；不需要 IAM TLS 文件及密码。
# internal-proxies 为匹配实际代理来源 IP 的正则；禁止留空或信任全部来源。
# 容器内探针还需显式加入 127.0.0.1，例如 '127\.0\.0\.1|172\.30\.0\.10'。
# 入口须清除并重设转发头，IAM 端口仅允许代理访问；保护密钥仍须提供。
SERVER_FORWARD_HEADERS_STRATEGY=NONE
SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=

# IAM 对外的 HTTPS 根地址（不带路径前缀），以及与其同源的身份前端地址。
IAM_PROTOCOL_ISSUER=https://iam.example.invalid:8443
IAM_PROTOCOL_IDENTITY_FRONTEND_URI=https://iam.example.invalid:8443/identity

# 可选：私有 CA 的 PEM 信任文件在容器内的路径。
# 默认使用系统信任库，需要时取消注释并提供对应文件。
# CURL_CA_BUNDLE=/run/iam/ca.pem
