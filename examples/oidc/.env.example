IAM_ISSUER=https://127.0.0.1:9443
IAM_IDENTITY_FRONTEND_URI=https://127.0.0.1:9443/identity
# 开发 CA 须在 Node 启动前通过环境变量 NODE_EXTRA_CA_CERTS 设置，见 README。
# 写入本文件不会加载该证书。

# Run the same BFF in two processes with independent Client IDs/secrets and RP_NAME=a/b.
RP_NAME=a
RP_ORIGIN=https://127.0.0.2:9444
RP_CLIENT_ID=replace-with-registered-client-id
RP_CLIENT_SECRET=replace-with-client-secret-returned-once
RP_SCOPES="openid profile offline_access"
RP_TLS_KEY_FILE=/absolute/path/rp-a-key.pem
RP_TLS_CERT_FILE=/absolute/path/rp-a-cert.pem
RP_SESSION_TTL_SECONDS=3600
RP_TRANSACTION_TTL_SECONDS=300
RP_MAX_SESSIONS=1000

# Optional BFF-to-resource call. Each RP must use the API associated with its registered resource.
API_ORIGIN=https://127.0.0.4:9446
API_AUDIENCE=orders-a
API_VALIDATION_CLIENT_ID=replace-with-resource-validation-client-id
API_VALIDATION_CLIENT_SECRET=replace-with-resource-validation-secret-returned-once
API_READ_ROLE=reader
API_WRITE_ROLE=editor
API_POSITIVE_CACHE_SECONDS=5
API_TLS_KEY_FILE=/absolute/path/api-a-key.pem
API_TLS_CERT_FILE=/absolute/path/api-a-cert.pem
